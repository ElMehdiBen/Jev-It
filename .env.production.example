# Public hostname. Create an A/AAAA record pointing this name to the VM first.
DOMAIN=jev.example.com
LETSENCRYPT_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Generate each password independently with: openssl rand -hex 32
# Keep usernames URL-safe (letters, numbers, underscores, and hyphens).
MONGO_ROOT_USERNAME=jev_root
MONGO_ROOT_PASSWORD=replace_with_64_hex_characters
MONGO_APP_USERNAME=jev_app
MONGO_APP_PASSWORD=replace_with_different_64_hex_characters
MONGODB_DATABASE=jev_studio

# Server-side provider credentials. Never prefix these with VITE_.
TYPESAFE_API_KEY=ts_replace_me
OPENAI_API_KEY=sk_replace_me
TYPESAFE_MODEL=jev-latest
OPENAI_MODEL=gpt-6-luna

# Google OAuth Web application credentials.
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI=https://jev.example.com/api/auth/google/callback

# Comma-separated emails allowed to view platform-wide analytics.
PLATFORM_ADMIN_EMAILS=you@example.com
