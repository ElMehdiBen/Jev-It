{
  "name": "jev-it",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch server.js\" \"vite\"",
    "docker:dev": "docker compose -f compose.dev.yml up --build",
    "docker:down": "docker compose -f compose.dev.yml down",
    "docker:logs": "docker compose -f compose.dev.yml logs -f app mongo",
    "prod:up": "docker compose --env-file .env.production -f compose.prod.yml up -d --build",
    "prod:logs": "docker compose --env-file .env.production -f compose.prod.yml logs -f --tail=200",
    "prod:down": "docker compose --env-file .env.production -f compose.prod.yml down",
    "db:dedupe-deployments": "node scripts/dedupe-deployments.js",
    "test:deploy-idempotency": "node scripts/test-deploy-idempotency.js",
    "build": "vite build",
    "start": "node server.js"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mongodb": "^7.7.0",
    "openai": "^7.23.0",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.4"
  }
}
