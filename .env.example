# Keep these server-side. Never prefix them with VITE_.
TYPESAFE_API_KEY=ts_your_key_here
OPENAI_API_KEY=sk_your_key_here

# Google OpenID Connect (Web application credentials)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# Comma-separated emails allowed to view platform-wide analytics.
PLATFORM_ADMIN_EMAILS=you@example.com

# Model and persistence
TYPESAFE_MODEL=jev-latest
OPENAI_MODEL=gpt-6-luna
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=jev_studio
# Only needed when Docker cannot forward the host's DNS. Use the active network DNS from `resolvectl dns`.
DEV_DNS=172.20.10.1
PORT=3001
